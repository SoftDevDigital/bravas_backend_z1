{
  "name": "bravas_backend_z1",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "nest build",
    "build:shared": "npm run --workspace=@bravas/shared build",
    "build:auth": "nest build auth-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:auth": "nest start auth-service",
    "start:auth:dev": "nest start auth-service --watch",
    "start:auth:debug": "nest start auth-service --debug --watch",
    "start:user": "nest start user-service",
    "start:user:dev": "nest start user-service --watch",
    "start:messages": "nest start messages-service",
    "start:messages:dev": "nest start messages-service --watch",
    "build:messages": "nest build messages-service",
    "start:contracts": "nest start contracts-service",
    "start:contracts:dev": "nest start contracts-service --watch",
    "build:contracts": "nest build contracts-service",
    "start:content": "nest start content-service",
    "start:content:dev": "nest start content-service --watch",
    "build:content": "nest build content-service",
    "start:notification": "nest start notification-service",
    "start:notification:dev": "nest start notification-service --watch",
    "build:notification": "nest build notification-service",
    "start:admin": "nest start admin-service",
    "start:admin:dev": "nest start admin-service --watch",
    "build:admin": "nest build admin-service",
    "build:user": "nest build user-service && node scripts/fix-user-service-main.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/bravas_backend_z1/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/bravas_backend_z1/test/jest-e2e.json",
    "verify:setup": "ts-node scripts/verify-setup.ts",
    "test:config": "ts-node scripts/test-config.ts",
    "verify:sessions": "ts-node scripts/verify-sessions.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.958.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.3",
    "@scalar/api-reference": "^1.40.5",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^27.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dompurify": "^3.3.1",
    "express": "^5.2.1",
    "jsdom": "^27.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "serverless-http": "^3.2.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/aws-lambda": "^8.10.145",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "serverless": "^3.38.0",
    "serverless-offline": "^13.0.0",
    "serverless-webpack": "^5.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "webpack": "^5.0.0",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  }
}